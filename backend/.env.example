# Application Configuration
APP_NAME=Stellar Instagram Downloader API
APP_VERSION=1.0.0
API_PREFIX=/api/v1

# Security (CHANGE THESE IN PRODUCTION!)
SECRET_KEY=your-secret-key-change-in-production-please-use-a-strong-random-key-at-least-32-chars
ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=1440

# CORS Origins (comma-separated)
CORS_ORIGINS=http://localhost:3000

# Directories
DATA_DIR=./data
SESSION_DIR=./.stellar/session

# Redis (optional - set USE_REDIS=true when Redis is available)
REDIS_URL=redis://localhost:6379
USE_REDIS=false

# Server
HOST=0.0.0.0
PORT=8000
RELOAD=true
