QWidget#AppRoot {
    background: #0F1115;
    color: #E5E7EB;
    font-family: "IBM Plex Sans", "Segoe UI", sans-serif;
    font-size: 14px;
}

QLabel#Brand {
    font-size: 20px;
    font-weight: 600;
}

QLabel#Title {
    font-size: 22px;
    font-weight: 600;
}

QLabel#SectionTitle {
    font-size: 16px;
    font-weight: 600;
}

QLabel#CardTitle {
    font-size: 15px;
    font-weight: 600;
}

QLabel#Muted {
    color: #9AA4B2;
}

QFrame#Card,
QFrame#ProjectCard,
QFrame#ClipTile {
    background: #161B22;
    border: 1px solid #2A3340;
    border-radius: 12px;
}

QFrame#CardError {
    background: #2A1C1C;
    border: 1px solid #6B2C2C;
    border-radius: 12px;
}

QFrame#StickyBar {
    background: #141A21;
    border: 1px solid #2A3340;
    border-radius: 12px;
}

QLabel#ProjectCover,
QLabel#ProjectCoverSmall,
QLabel#ClipThumb {
    background: #202633;
    border-radius: 10px;
}

QLabel#ProjectCover {
    border: 1px solid #2A3340;
}

QLineEdit#Input {
    border: 1px solid #2A3340;
    border-radius: 8px;
    padding: 8px 10px;
    background: #0F141B;
    color: #E5E7EB;
}

QLineEdit#Input::placeholder {
    color: #6B7280;
}

QPushButton#PrimaryButton {
    background: #3B82F6;
    color: #FFFFFF;
    border-radius: 8px;
    padding: 8px 16px;
    font-weight: 600;
}

QPushButton#PrimaryButton:disabled {
    background: #1F4FA5;
    color: #9AA4B2;
}

QPushButton#SecondaryButton {
    background: #0F141B;
    color: #E5E7EB;
    border: 1px solid #2A3340;
    border-radius: 8px;
    padding: 8px 14px;
}

QPushButton#SecondaryButton:disabled {
    color: #6B7280;
}

QPushButton#DestructiveButton {
    background: #2A1C1C;
    color: #FCA5A5;
    border: 1px solid #6B2C2C;
    border-radius: 8px;
    padding: 8px 14px;
}

QPushButton#NavButton {
    background: transparent;
    border: 1px solid #2A3340;
    border-radius: 8px;
    padding: 6px 12px;
    color: #E5E7EB;
}

QToolButton#StepperButton {
    background: #121722;
    border-radius: 8px;
    padding: 6px 12px;
    color: #E5E7EB;
}

QToolButton#StepperButton[state="current"] {
    background: #3B82F6;
    color: #FFFFFF;
}

QToolButton#StepperButton[state="done"] {
    background: #1E3A8A;
    color: #E5E7EB;
}

QToolButton#StepperButton[state="disabled"] {
    background: #0F141B;
    color: #6B7280;
}

QLabel#StatusPill {
    background: #202633;
    border-radius: 10px;
    padding: 2px 10px;
    font-size: 12px;
    color: #C7D2FE;
}

QLabel#StatusPill[tone="success"] {
    background: #0F2A1E;
    color: #86EFAC;
}

QLabel#StatusPill[tone="info"] {
    background: #0F1E3A;
    color: #93C5FD;
}

QLabel#StatusPill[tone="danger"] {
    background: #2A1C1C;
    color: #FCA5A5;
}

QLabel#StatusPill[tone="warning"] {
    background: #2A2415;
    color: #FCD34D;
}

QLabel#StatusPill[tone="neutral"] {
    background: #202633;
    color: #C7D2FE;
}

QFrame#ProjectCard:hover {
    border: 1px solid #3B82F6;
}

QListWidget#ClipList {
    background: transparent;
    border: none;
}

QFrame#ClipTile[selected="true"] {
    border: 2px solid #3B82F6;
}

QProgressBar {
    background: #202633;
    border-radius: 6px;
    height: 8px;
    color: #E5E7EB;
}

QProgressBar::chunk {
    background: #3B82F6;
    border-radius: 6px;
}

QPushButton#Chip {
    border: 1px solid #2A3340;
    border-radius: 16px;
    padding: 6px 12px;
    background: #0F141B;
    color: #E5E7EB;
}

QPushButton#Chip:checked {
    background: #3B82F6;
    color: #FFFFFF;
    border: 1px solid #3B82F6;
}

QFrame#Toast {
    background: #111827;
    color: #F9FAFB;
    border-radius: 10px;
}

QFrame#Toast[level="success"] {
    background: #0F2A1E;
}

QFrame#Toast[level="error"] {
    background: #2A1C1C;
}

QFrame#Toast[level="info"] {
    background: #111827;
}
